@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# A last-modified value that is not a date.

<http://example.org/gems/>
    a skos:ConceptScheme ;
    skos:prefLabel "Gemstones"@en ;
    dcterms:modified "last spring" ;
    skos:hasTopConcept <http://example.org/gems/diamond> .

<http://example.org/gems/diamond>
    a skos:Concept ;
    skos:inScheme <http://example.org/gems/> ;
    skos:prefLabel "Diamond"@en .
