@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# A file declaring two vocabularies with an equal claim on its concepts: one
# concept belongs to each. Nothing in the file says which one the import is
# about, so a run naming no target is refused rather than resolved by the
# alphabet. Naming one of them as the target refuses the other as a mismatch,
# since its own statements would have nowhere to go.

<http://example.org/alpha/>
    a skos:ConceptScheme ;
    skos:prefLabel "Alpha vocabulary"@en .

<http://example.org/beta/>
    a skos:ConceptScheme ;
    skos:prefLabel "Beta vocabulary"@en .

<http://example.org/alpha/one>
    a skos:Concept ;
    skos:inScheme <http://example.org/alpha/> ;
    skos:prefLabel "One"@en .

<http://example.org/beta/two>
    a skos:Concept ;
    skos:inScheme <http://example.org/beta/> ;
    skos:prefLabel "Two"@en .
