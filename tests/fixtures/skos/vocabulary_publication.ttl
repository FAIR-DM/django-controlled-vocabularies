@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# A vocabulary that states who publishes it, who created it, its licence, its
# version and when it last changed.

<http://example.org/gems/>
    a skos:ConceptScheme ;
    skos:prefLabel "Gemstones"@en ;
    dcterms:publisher "Gem Survey" ;
    dcterms:creator "A. Lapidary" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "2.1" ;
    dcterms:modified "2026-03-14"^^xsd:date ;
    skos:hasTopConcept <http://example.org/gems/diamond> .

<http://example.org/gems/diamond>
    a skos:Concept ;
    skos:inScheme <http://example.org/gems/> ;
    skos:prefLabel "Diamond"@en .
