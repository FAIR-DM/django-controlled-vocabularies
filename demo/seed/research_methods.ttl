@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .

# No skos:ConceptScheme is declared in this file — demo/management/commands/seed_demo.py loads
# it against a vocabulary created directly here, in the demo, so it lands as authored here
# rather than imported from a publisher: the same no_scheme_declared.ttl shape this package's
# own test suite uses (013-find-a-vocabulary task brief, T016).

<http://example.org/research-methods/fieldwork>
    a skos:Concept ;
    skos:prefLabel "Fieldwork"@en ;
    skos:altLabel "Field work"@en ;
    # A common misspelling (T016, US-3): the reader never sees this, only a search for it
    # finds the concept, which is the one thing about a hidden label a page cannot show.
    skos:hiddenLabel "Feildwork"@en ;
    skos:definition "Data collected through direct observation or measurement at a study site."@en ;
    # 015-read-single-record T024: a German-only note, carrying no English value of its
    # own — read under a German reading language it shows directly, while the English-only
    # skos:definition above falls back to its English value on the very same page, so the
    # demo walk exercises both halves of FR-005 (a value in the reading language, and a
    # value with none falling back to the vocabulary's own default) in one request.
    skos:scopeNote "Erhoben durch unmittelbare Beobachtung oder Messung am Studienort."@de .

<http://example.org/research-methods/laboratory-experiment>
    a skos:Concept ;
    skos:prefLabel "Laboratory experiment"@en ;
    skos:definition "Data produced under controlled conditions in a laboratory setting."@en ;
    # An associative link, stated once: skos:related is symmetric, so remote-sensing's own
    # page shows this concept back without a second statement here.
    skos:related <http://example.org/research-methods/remote-sensing> .

<http://example.org/research-methods/survey>
    a skos:Concept ;
    skos:prefLabel "Survey"@en ;
    skos:definition "Data gathered by questionnaire or structured interview."@en ;
    # 015-read-single-record T024, FR-010: a survey carried out at the study site is a form
    # of fieldwork — the hierarchical pair the demo walk follows in both directions, since
    # skos:narrower is derived from this one stored statement rather than stated separately.
    skos:broader <http://example.org/research-methods/fieldwork> .

<http://example.org/research-methods/remote-sensing>
    a skos:Concept ;
    skos:prefLabel "Remote sensing"@en, "Fernerkundung"@de ;
    skos:definition "Data captured from a distance, typically by satellite or aircraft instrument."@en ;
    # A notation, a mapping to a concept of the other seeded vocabulary, and a statement from
    # outside SKOS: an import keeps each of them, and the concept's page shows them.
    skos:notation "DCM-RS" ;
    skos:relatedMatch <http://purl.org/dc/dcmitype/Image> ;
    schema:keywords "satellite"@en .

# One of each kind (T020, FR-018, decisions.md D9): a plain set, and a deliberately
# sequenced grouping, both loaded through the package's own importer
# (controlled_vocabularies.exchange.import_skos) rather than a fixture behind it. Placed
# in this file rather than dcmi_types.ttl: this vocabulary's own concept URIs already
# live under the reserved example.org placeholder domain (RFC 2606), so a curator's own
# grouping minted here claims nothing about what the DCMI Type Vocabulary's real
# publisher has actually published.

<http://example.org/research-methods/collection/primary-methods>
    a skos:Collection ;
    skos:prefLabel "Primary data collection methods"@en ;
    skos:member
        <http://example.org/research-methods/fieldwork>,
        <http://example.org/research-methods/laboratory-experiment>,
        <http://example.org/research-methods/survey>,
        <http://example.org/research-methods/remote-sensing> .

<http://example.org/research-methods/collection/typical-workflow>
    a skos:OrderedCollection ;
    skos:prefLabel "Typical project workflow"@en ;
    skos:memberList (
        <http://example.org/research-methods/survey>
        <http://example.org/research-methods/fieldwork>
        <http://example.org/research-methods/remote-sensing>
        <http://example.org/research-methods/laboratory-experiment>
    ) .
