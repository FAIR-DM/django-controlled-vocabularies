@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The DCMI Type Vocabulary, published by the Dublin Core Metadata Initiative at these stable
# URIs — real, recognisable content rather than invented placeholder text (013-find-a-vocabulary
# task brief, T016). Declared in demo/settings.py and loaded by sync_vocabularies, so this
# file's own skos:ConceptScheme declaration is what the demo's vocabulary lands as: one fixed
# by an external publisher, i.e. "Imported" on the vocabulary list.

<http://purl.org/dc/dcmitype/>
    a skos:ConceptScheme ;
    skos:prefLabel "DCMI Type Vocabulary"@en ;
    dcterms:description "A general, cross-domain list of resource types used to categorise the nature or genre of a resource."@en ;
    dcterms:publisher "Dublin Core Metadata Initiative" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2012-06-14"^^xsd:date ;
    skos:hasTopConcept
        <http://purl.org/dc/dcmitype/Collection>,
        <http://purl.org/dc/dcmitype/Dataset>,
        <http://purl.org/dc/dcmitype/Image>,
        <http://purl.org/dc/dcmitype/Software>,
        <http://purl.org/dc/dcmitype/Text> .

<http://purl.org/dc/dcmitype/Collection>
    a skos:Concept ;
    skos:inScheme <http://purl.org/dc/dcmitype/> ;
    skos:topConceptOf <http://purl.org/dc/dcmitype/> ;
    skos:prefLabel "Collection"@en ;
    skos:definition "An aggregation of resources."@en .

<http://purl.org/dc/dcmitype/Dataset>
    a skos:Concept ;
    skos:inScheme <http://purl.org/dc/dcmitype/> ;
    skos:topConceptOf <http://purl.org/dc/dcmitype/> ;
    skos:prefLabel "Dataset"@en ;
    skos:altLabel "Data set"@en ;
    # A common misspelling (T016, US-3): the reader never sees this, only a search for it
    # finds the concept, which is the one thing about a hidden label a page cannot show.
    skos:hiddenLabel "Datset"@en ;
    skos:definition "Data encoded in a defined structure."@en .

<http://purl.org/dc/dcmitype/Image>
    a skos:Concept ;
    skos:inScheme <http://purl.org/dc/dcmitype/> ;
    skos:topConceptOf <http://purl.org/dc/dcmitype/> ;
    skos:prefLabel "Image"@en ;
    skos:definition "A visual representation other than text."@en .

<http://purl.org/dc/dcmitype/Software>
    a skos:Concept ;
    skos:inScheme <http://purl.org/dc/dcmitype/> ;
    skos:topConceptOf <http://purl.org/dc/dcmitype/> ;
    skos:prefLabel "Software"@en ;
    skos:definition "A computer program in source or compiled form."@en .

<http://purl.org/dc/dcmitype/Text>
    a skos:Concept ;
    skos:inScheme <http://purl.org/dc/dcmitype/> ;
    skos:topConceptOf <http://purl.org/dc/dcmitype/> ;
    skos:prefLabel "Text"@en ;
    skos:definition "A resource consisting primarily of words for reading."@en .
